{
  "name": "prepml",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,runner -c cyan,magenta \"vite\" \"node server/runner.mjs\"",
    "dev:web": "vite",
    "runner": "node server/runner.mjs",
    "build": "tsc -b && vite build",
    "preview": "concurrently -k -n web,runner \"vite preview\" \"node server/runner.mjs\"",
    "typecheck": "tsc -b",
    "validate": "tsx scripts/validate.ts"
  },
