    "cmdk": "^1.1.1",
    "framer-motion": "^13.5.0",
    "fuse.js": "^7.5.0",
    "katex": "^0.18.10",
    "lucide-react": "^1.49.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
